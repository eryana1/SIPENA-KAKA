rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow reading and writing school app accounts for authentication & user management
    match /app_accounts/{accountId} {
      allow read, write: if true;
    }
    
    // Allow users to read and write their documents
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }
  }
}
